# GETSET customer website. Copy to .env.local for development.

# Public address of this site (canonical URLs, sitemap, structured data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The GETSET API. The browser calls it for paging, search and enquiries, and photos load from it.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: a private address for server-side reads (same as above if unset).
# GETSET_API_URL=http://api.internal:4000

# Server-only. Must equal the API's REVALIDATE_SECRET: lets the API refresh cached pages after admin changes.
REVALIDATE_SECRET=change-me-to-the-same-value-as-the-api
